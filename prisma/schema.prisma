generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id                 String   @id @default(uuid())
  name_project       String
  installation_location String?
  order_number      String?
  status             String   @default("NOVO")
  production_deadline Int?

  instrucao_date DateTime?
  instrucao_responsavel String?

  medicao_date DateTime?
  medicao_responsavel String?

  pre_instalacao_date DateTime?
  pre_instalacao_responsavel String?

  pos_instalacao_date DateTime?
  pos_instalacao_responsavel String?

  entrega_obra_date DateTime?
  entrega_obra_responsavel String?
  
  etapa_final_date DateTime?
  etapa_final_responsavel String?

  @@map("projects")
}